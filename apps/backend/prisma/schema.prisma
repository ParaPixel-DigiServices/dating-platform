generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// AUTH ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum VerificationType {
  PHONE
  EMAIL
  SELFIE
  GOVERNMENT_ID
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id           String     @id @default(uuid()) @db.Uuid
  firebaseUid  String     @unique
  phoneNumber  String?    @unique
  email        String?    @unique
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  lastActiveAt DateTime?

  devices               Device[]
  sessions              Session[]
  verifications         UserVerification[] @relation("UserVerifications")
  verificationsReviewed UserVerification[] @relation("VerificationReviewer")
  profile               Profile?

  moderationActionsReceived  ModerationAction[] @relation("UserModerationActions")
  moderationActionsPerformed ModerationAction[] @relation("AdminModerationActions")
  reportsAssigned            Report[]           @relation("ReportAssignee")

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  wallet           Wallet?
  fiatTransactions FiatTransaction[]

  socialPosts    SocialPost[]
  socialComments SocialComment[]
  socialVotes    SocialVote[]

  @@index([status])
  @@index([lastActiveAt])
}

model Device {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientDeviceId String
  deviceName     String?
  platform       DevicePlatform
  appVersion     String?
  pushToken      String?        @unique
  lastActiveAt   DateTime?
  sessions       Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, clientDeviceId])
  @@index([userId])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId         String    @db.Uuid
  device           Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  revokedAt        DateTime?

  @@index([userId])
  @@index([deviceId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model UserVerification {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @db.Uuid
  user            User               @relation("UserVerifications", fields: [userId], references: [id], onDelete: Restrict)
  type            VerificationType
  status          VerificationStatus @default(PENDING)
  rejectionReason String?
  verifiedAt      DateTime?
  // The admin/moderator who reviewed this verification
  reviewedById    String?            @db.Uuid
  reviewedBy      User?              @relation("VerificationReviewer", fields: [reviewedById], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([userId, type])
  @@index([status])
  @@index([reviewedById])
}

// ─────────────────────────────────────────────
// PROFILE ENUMS
// ─────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EducationLevel {
  HIGH_SCHOOL
  DIPLOMA
  BACHELORS
  MASTERS
  PHD
  OTHER
}

enum WorkSector {
  PRIVATE
  GOVT
  DEFENSE
  BUSINESS
  NOT_WORKING
}

enum WorkRole {
  BANKING
  CA
  INVESTMENT
  SOFTWARE_DEVELOPER
  ARCHITECT
  FASHION_DESIGNER
  OTHER
}

enum DietPreference {
  VEGETARIAN
  NON_VEGETARIAN
  EGGETARIAN
  VEGAN
  OTHER
}

enum SmokingHabit {
  NEVER
  OCCASIONALLY
  REGULARLY
}

enum DrinkingHabit {
  NEVER
  OCCASIONALLY
  REGULARLY
}

// Consolidated: replaces both ImportanceLevel and PreferenceLevel (both were LOW/MEDIUM/HIGH)
enum ImportanceLevel {
  LOW
  MEDIUM
  HIGH
}

enum PersonalityType {
  INTROVERT
  EXTROVERT
  AMBIVERT
}

// ─────────────────────────────────────────────
// RELIGION & CASTE (Lookup tables)
// ─────────────────────────────────────────────

model Religion {
  id                          String                     @id @default(uuid()) @db.Uuid
  name                        String                     @unique
  displayOrder                Int?
  isActive                    Boolean                    @default(true)
  profiles                    Profile[]
  preferredByPartnerReligions PartnerPreferredReligion[]
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
}

model Caste {
  id            String  @id @default(uuid()) @db.Uuid
  name          String  @unique
  parentCasteId String? @db.Uuid
  parentCaste   Caste?  @relation("CasteHierarchy", fields: [parentCasteId], references: [id])
  childCastes   Caste[] @relation("CasteHierarchy")
  state         String?
  displayOrder  Int?
  isActive      Boolean @default(true)

  profiles                 Profile[]
  preferredByPartnerCastes PartnerPreferredCaste[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
}

// ─────────────────────────────────────────────
// PROFILE
// ─────────────────────────────────────────────

model Profile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Identity
  firstName   String
  lastName    String
  dateOfBirth DateTime @db.Date
  gender      Gender
  bio         String?
  heightCm    Int? // User's height in centimetres

  // Category — set during onboarding.
  // INVARIANT (enforced by backend, not DB):
  //   LOVE    → LoveProfile MUST exist,    MarriageProfile MUST NOT
  //   MARRIAGE → MarriageProfile MUST exist, LoveProfile MUST NOT
  category CategoryType?
  onboardingStatus Boolean @default(false)

  // Location — lat/lng for proximity queries; city/state/country for display.
  // Resolved via Google Maps API; stored provider-agnostically.
  // For radius queries use a bounding-box pre-filter on lat/lng.
  latitude  Float?
  longitude Float?
  city      String?
  state     String?
  country   String?

  // Education & Career
  educationLevel String?
  college        String?
  occupation     String? // Kept for legacy/free-text
  workSector     String?
  companyName    String?

  maritalStatus    String?
  disabilityStatus String?

  // Financial
  annualIncome   String?
  incomeCurrency String?  @default("INR")

  // Cultural
  religionId   String?   @db.Uuid
  religion     Religion? @relation(fields: [religionId], references: [id])
  casteId      String?   @db.Uuid
  caste        Caste?    @relation(fields: [casteId], references: [id])
  motherTongue String?

  // Lifestyle
  dietPreference    String?
  smokingHabit      String?
  drinkingHabit     String?
  fitnessImportance ImportanceLevel?
  petsPreference    ImportanceLevel?

  // Personality
  personalityType PersonalityType?

  // Completion
  completionPercentage Int     @default(0)
  isCompleted          Boolean @default(false)

  // Incremented on relevant data changes (e.g. MCQ updates) to trigger AI report regeneration.
  compatibilityVersion Int @default(1)

  // Relations
  photos            ProfilePhoto[]
  languages         UserLanguage[]
  interests         UserInterest[]
  userAnswers       UserAnswer[]
  loveProfile       LoveProfile?
  marriageProfile   MarriageProfile?
  partnerPreference PartnerPreference?

  sentInteractions     ProfileInteraction[] @relation("InteractionSender")
  receivedInteractions ProfileInteraction[] @relation("InteractionReceiver")
  matchesAsProfileOne  Match[]              @relation("MatchProfileOne")
  matchesAsProfileTwo  Match[]              @relation("MatchProfileTwo")
  messagesSent         Message[]
  blocksCreated        Block[]              @relation("ProfileBlocks")
  blockedBy            Block[]              @relation("BlockedByProfiles")
  reportsCreated       Report[]             @relation("ReportsCreated")
  reportsReceived      Report[]             @relation("ReportsReceived")

  // Love feature back-relations
  sparkSubmissionsSent    SparkSubmission[] @relation("SparksSent")
  // InsightReport is per-subject (shared across all viewers); no requester back-relation
  insightReportsAsSubject InsightReport[]   @relation("InsightSubject")
  syncReportsAsA          SyncReport[]      @relation("SyncProfileA")
  syncReportsAsB          SyncReport[]      @relation("SyncProfileB")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([category])
  @@index([latitude, longitude])
  @@index([city, state, country])
  @@index([gender])
  @@index([religionId])
  @@index([casteId])
  @@index([religionId, state])
}

// ─────────────────────────────────────────────
// PROFILE PHOTOS
// ─────────────────────────────────────────────

enum PhotoModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProfilePhoto {
  id               String                @id @default(uuid()) @db.Uuid
  profileId        String                @db.Uuid
  profile          Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  storageKey       String
  cdnUrl           String
  displayOrder     Int
  // Enforced at service level: Only one photo per profile should have isPrimary = true
  isPrimary        Boolean               @default(false)
  moderationStatus PhotoModerationStatus @default(PENDING)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([profileId])
}

// ─────────────────────────────────────────────
// LANGUAGE & INTERESTS (Lookup + Join tables)
// ─────────────────────────────────────────────

model Language {
  id                          String                     @id @default(uuid()) @db.Uuid
  name                        String                     @unique
  code                        String                     @unique
  displayOrder                Int?
  isActive                    Boolean                    @default(true)
  users                       UserLanguage[]
  preferredByPartnerLanguages PartnerPreferredLanguage[]
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
}

enum LanguageProficiency {
  BASIC
  CONVERSATIONAL
  FLUENT
  NATIVE
}

model UserLanguage {
  id          String               @id @default(uuid()) @db.Uuid
  profileId   String               @db.Uuid
  languageId  String               @db.Uuid
  profile     Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  language    Language             @relation(fields: [languageId], references: [id])
  proficiency LanguageProficiency?
  createdAt   DateTime             @default(now())

  @@unique([profileId, languageId])
}

model Interest {
  id                          String                     @id @default(uuid()) @db.Uuid
  name                        String                     @unique
  category                    String?
  displayOrder                Int?
  isActive                    Boolean                    @default(true)
  users                       UserInterest[]
  preferredByPartnerInterests PartnerPreferredInterest[]
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
}

model UserInterest {
  id         String   @id @default(uuid()) @db.Uuid
  profileId  String   @db.Uuid
  interestId String   @db.Uuid
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([profileId, interestId])
}

// ─────────────────────────────────────────────
// QUESTIONS & ANSWERS (Insights & Synchronization)
// ─────────────────────────────────────────────

enum QuestionCategory {
  INSIGHT
  SYNCHRONIZATION
}

model Question {
  id           String           @id @default(uuid()) @db.Uuid
  category     QuestionCategory
  text         String           @db.Text
  options      Json // Storing options as JSON array
  displayOrder Int              @default(0)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  answers UserAnswer[]

  @@index([category])
}

model UserAnswer {
  id         String   @id @default(uuid()) @db.Uuid
  profileId  String   @db.Uuid
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  questionId String   @db.Uuid
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     String   @db.Text // Store the selected option text or ID
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([profileId, questionId])
  @@index([profileId])
  @@index([questionId])
}

// ─────────────────────────────────────────────
// CATEGORY
// Category is now a simple enum field on Profile.
// Category/SubCategory/UserCategory tables intentionally removed.
// Marriage religion/caste are captured via Profile.religionId and Profile.casteId.
// We use a single, unified MarriageProfile for all religions.
// ─────────────────────────────────────────────

enum CategoryType {
  LOVE
  MARRIAGE
}

// ─────────────────────────────────────────────
// LOVE PROFILE
// ─────────────────────────────────────────────

enum RelationshipIntent {
  LONG_TERM
  OPEN_TO_MARRIAGE
  UNDECIDED
}

model LoveProfile {
  id        String  @id @default(uuid()) @db.Uuid
  profileId String  @unique @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  voiceIntroUrl String?
  videoIntroUrl String?

  sparkProfile SparkProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// SPARK FEATURE  (Love users only)
//
// Versioning model:
//   SparkProfile       — config + pointer to active version
//   SparkProfileVersion — immutable snapshot of a question set
//   SparkQuestion      — belongs to a version; never mutated
//   SparkSubmission    — references the exact version answered
//   SparkAnswer        — answer to one question in that version
//   SparkAIReport      — AI output for one submission
//
// To publish new questions: create a new SparkProfileVersion with
// new SparkQuestion rows, then set SparkProfile.activeVersionId.
// Old submissions remain tied to their original version.
// ─────────────────────────────────────────────

model SparkProfile {
  id            String      @id @default(uuid()) @db.Uuid
  loveProfileId String      @unique @db.Uuid
  loveProfile   LoveProfile @relation(fields: [loveProfileId], references: [id], onDelete: Cascade)
  isActive      Boolean     @default(true)

  // Configuration — not hardcoded in the backend
  maxQuestions      Int     @default(5)
  isPublic          Boolean @default(true)
  allowResubmission Boolean @default(false)

  // The currently live version. Null until first version is published.
  activeVersionId String?              @unique @db.Uuid
  activeVersion   SparkProfileVersion? @relation("ActiveSparkVersion", fields: [activeVersionId], references: [id])

  versions    SparkProfileVersion[] @relation("SparkVersions")
  submissions SparkSubmission[]     @relation("SparkTarget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Immutable snapshot of a question set at a point in time.
// Never mutate rows in this table — create a new version instead.
model SparkProfileVersion {
  id             String       @id @default(uuid()) @db.Uuid
  sparkProfileId String       @db.Uuid
  sparkProfile   SparkProfile @relation("SparkVersions", fields: [sparkProfileId], references: [id], onDelete: Cascade)
  versionNumber  Int // Monotonically increasing per SparkProfile

  questions   SparkQuestion[]
  submissions SparkSubmission[] @relation("SubmissionVersion")

  // Back-relation for SparkProfile.activeVersionId
  activeForProfile SparkProfile? @relation("ActiveSparkVersion")

  createdAt DateTime @default(now())

  @@unique([sparkProfileId, versionNumber])
  @@index([sparkProfileId])
}

// Immutable: belongs to a SparkProfileVersion, not the SparkProfile directly.
// Do not add updatedAt — question text must never change after creation.
model SparkQuestion {
  id                    String              @id @default(uuid()) @db.Uuid
  sparkProfileVersionId String              @db.Uuid
  sparkProfileVersion   SparkProfileVersion @relation(fields: [sparkProfileVersionId], references: [id], onDelete: Cascade)
  text                  String              @db.Text
  displayOrder          Int
  isRequired            Boolean             @default(true)
  answers               SparkAnswer[]
  createdAt             DateTime            @default(now())

  @@index([sparkProfileVersionId])
}

enum SparkSubmissionStatus {
  DRAFT // Sender opened Spark screen, has not submitted yet
  SUBMITTED // Answers submitted; AI job queued
  COMPLETED // AI report ready for SparkProfile owner
  FAILED // AI generation failed; eligible for retry
}

model SparkSubmission {
  id String @id @default(uuid()) @db.Uuid

  // The specific immutable version the sender answered
  // Service layer MUST transactionally validate that:
  // - sparkProfileVersion belongs to the target sparkProfile
  // - All answered questionIds belong to this sparkProfileVersion
  sparkProfileVersionId String              @db.Uuid
  sparkProfileVersion   SparkProfileVersion @relation("SubmissionVersion", fields: [sparkProfileVersionId], references: [id])

  // Denormalized from sparkProfileVersion.sparkProfileId for efficient querying
  // and for enforcing one-submission-per-profile-pair uniqueness.
  sparkProfileId String       @db.Uuid
  sparkProfile   SparkProfile @relation("SparkTarget", fields: [sparkProfileId], references: [id])

  senderProfileId String  @db.Uuid
  senderProfile   Profile @relation("SparksSent", fields: [senderProfileId], references: [id])

  status SparkSubmissionStatus @default(DRAFT)

  // Viewed as a flag, not a status enum value
  isViewedByOwner Boolean   @default(false)
  viewedAt        DateTime?

  answers     SparkAnswer[]
  aiReport    SparkAIReport?
  interaction ProfileInteraction?

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Uniqueness semantics depend on allowResubmission (SparkProfile config):
  //
  //   allowResubmission = false:
  //     Backend rejects any new submission where a prior row exists for this pair
  //     (regardless of deletedAt). Enforced in the service layer.
  //
  //   allowResubmission = true:
  //     Backend soft-deletes (sets deletedAt) the previous submission, then inserts
  //     a new one. All historical submissions are preserved for audit/AI history.
  //     The DB carries no unique constraint here — the service owns this invariant.
  //
  // Active submission query pattern:
  //   WHERE sparkProfileId = ? AND senderProfileId = ? AND deletedAt IS NULL
  //
  @@index([sparkProfileId, senderProfileId]) // query active submission for a pair
  @@index([sparkProfileVersionId])
  @@index([sparkProfileId])
  @@index([senderProfileId])
  @@index([status])
}

model SparkAnswer {
  id           String          @id @default(uuid()) @db.Uuid
  submissionId String          @db.Uuid
  submission   SparkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String          @db.Uuid
  question     SparkQuestion   @relation(fields: [questionId], references: [id])
  answer       String          @db.Text
  createdAt    DateTime        @default(now())

  @@unique([submissionId, questionId])
  @@index([submissionId])
}

model SparkAIReport {
  id           String          @id @default(uuid()) @db.Uuid
  submissionId String          @unique @db.Uuid
  submission   SparkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  data         Json // Full AI output (tone, compatibility signals, personality observations)
  aiJobId      String?         @unique @db.Uuid
  aiJob        AIJob?          @relation(fields: [aiJobId], references: [id])
  generatedAt  DateTime        @default(now())
}

// ─────────────────────────────────────────────
// INSIGHT REPORT  (Love users only)
//
// One shared report per subject profile.
// All viewers of profile B see the same cached Insight.
// Marked STALE when the subject's compatibilityVersion increments (e.g. MCQ updates).
// Regenerated on next request, capturing the new sourceProfileVersion.
// ─────────────────────────────────────────────

enum InsightReportStatus {
  PENDING // AI generation queued
  COMPLETED // Report ready
  FAILED // AI failed; can retry
  STALE // Subject updated MCQ answers; needs regeneration
}

model InsightReport {
  id                   String              @id @default(uuid()) @db.Uuid
  // The profile being analyzed. One report per subject (shared across all viewers).
  subjectProfileId     String              @unique @db.Uuid
  subjectProfile       Profile             @relation("InsightSubject", fields: [subjectProfileId], references: [id], onDelete: Cascade)
  sourceProfileVersion Int
  status               InsightReportStatus @default(PENDING)
  data                 Json? // personality, values, love language, strengths, red/green flags
  aiJobId              String?             @unique @db.Uuid
  aiJob                AIJob?              @relation(fields: [aiJobId], references: [id])
  version              Int                 @default(1)
  generatedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?

  // @@index([subjectProfileId]) omitted — subjectProfileId @unique already creates the index
  @@index([status])
}

// ─────────────────────────────────────────────
// SYNC REPORT  (Love users only)
// AI compatibility report between two profiles.
// profileAId/profileBId stored in canonical order (lower UUID first) — enforced at API layer.
// Marked STALE if either profile's compatibilityVersion increments.
// The next generation must capture the new compatibility versions.
// ─────────────────────────────────────────────

enum SyncReportStatus {
  PENDING
  COMPLETED
  FAILED
  STALE
}

// IMPORTANT: profileAId must always be the lexicographically smaller UUID.
// The API layer must enforce this before every insert/query to prevent duplicate pairs.
model SyncReport {
  id              String  @id @default(uuid()) @db.Uuid
  profileAId      String  @db.Uuid
  profileA        Profile @relation("SyncProfileA", fields: [profileAId], references: [id], onDelete: Cascade)
  profileAVersion Int

  profileBId      String  @db.Uuid
  profileB        Profile @relation("SyncProfileB", fields: [profileBId], references: [id], onDelete: Cascade)
  profileBVersion Int

  status       SyncReportStatus @default(PENDING)
  overallScore Int? // 0-100 extracted for fast sorting without JSON parsing
  data         Json? // compatibility breakdown, strengths, weak areas, recommendations
  aiJobId      String?          @unique @db.Uuid
  aiJob        AIJob?           @relation(fields: [aiJobId], references: [id])
  version      Int              @default(1)
  generatedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([profileAId, profileBId])
  @@index([profileAId])
  @@index([profileBId])
}

// ─────────────────────────────────────────────
// AI JOB  (Centralised AI generation queue)
// One AIJob per AI report. Handles queueing, retries,
// provider metadata, token usage, and cost tracking.
// ─────────────────────────────────────────────

enum AIJobType {
  SPARK_REPORT
  INSIGHT_REPORT
  SYNC_REPORT
}

enum AIJobStatus {
  QUEUED // Waiting to be picked up
  PROCESSING // Currently being generated
  COMPLETED // Generation succeeded
  FAILED // All retries exhausted
}

model AIJob {
  id     String      @id @default(uuid()) @db.Uuid
  type   AIJobType
  status AIJobStatus @default(QUEUED)

  // AI provider metadata
  provider         String? // "openai" | "anthropic" | "gemini"
  model            String? // "gpt-4o" | "claude-3-5-sonnet" | "gemini-2.0-flash"
  promptTokens     Int?
  completionTokens Int?
  tokensUsed       Int? // total (promptTokens + completionTokens)
  generationTimeMs Int?
  costUsd          Decimal? @db.Decimal(10, 6)

  // Retry tracking
  retryCount Int     @default(0)
  maxRetries Int     @default(3)
  lastError  String? @db.Text

  // Timestamps
  queuedAt    DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Back-relations to report tables (one AIJob → one report)
  sparkReport   SparkAIReport?
  insightReport InsightReport?
  syncReport    SyncReport?

  @@index([status])
  @@index([type])
  @@index([type, status])
}

