  id        String  @id @default(uuid()) @db.Uuid
  profileId String  @unique @db.Uuid
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Hard filters
  minAge        Int?
  maxAge        Int?
  minHeightCm   Int?
  maxHeightCm   Int?
  maxDistanceKm Int?
  minIncome     Decimal? @db.Decimal(15, 2)
  maxIncome     Decimal? @db.Decimal(15, 2)

  // Soft preference weights (0–100)
  valuesWeight    Int? @default(50)
  lifestyleWeight Int? @default(50)
  looksWeight     Int? @default(50)
  careerWeight    Int? @default(50)
  familyWeight    Int? @default(50)

  // Enum preferences
  genderPreference Gender[]
  educationLevels  EducationLevel[]
  dietPreferences  DietPreference[]
  smokingHabits    SmokingHabit[]
  drinkingHabits   DrinkingHabit[]

  // Relational preferences
  preferredCastes    PartnerPreferredCaste[]
  preferredReligions PartnerPreferredReligion[]
  preferredLanguages PartnerPreferredLanguage[]
  preferredInterests PartnerPreferredInterest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
