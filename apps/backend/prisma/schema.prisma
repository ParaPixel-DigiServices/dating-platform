model PartnerPreferredReligion {
  id                  String            @id @default(uuid()) @db.Uuid
  partnerPreferenceId String            @db.Uuid
  partnerPreference   PartnerPreference @relation(fields: [partnerPreferenceId], references: [id], onDelete: Cascade)
  religionId          String            @db.Uuid
  religion            Religion          @relation(fields: [religionId], references: [id])

  @@unique([partnerPreferenceId, religionId])
}

model PartnerPreferredLanguage {
  id                  String            @id @default(uuid()) @db.Uuid
  partnerPreferenceId String            @db.Uuid
  partnerPreference   PartnerPreference @relation(fields: [partnerPreferenceId], references: [id], onDelete: Cascade)
  languageId          String            @db.Uuid
  language            Language          @relation(fields: [languageId], references: [id])

  @@unique([partnerPreferenceId, languageId])
}

model PartnerPreferredInterest {
  id                  String            @id @default(uuid()) @db.Uuid
  partnerPreferenceId String            @db.Uuid
  partnerPreference   PartnerPreference @relation(fields: [partnerPreferenceId], references: [id], onDelete: Cascade)
  interestId          String            @db.Uuid
  interest            Interest          @relation(fields: [interestId], references: [id])

  @@unique([partnerPreferenceId, interestId])
}

// ─────────────────────────────────────────────
// INTERACTIONS
//
// Represents CURRENT interaction state (A → B).
// One row per directional pair. Use upsert to change state.
//
// Interaction matrix (enforced at API layer):
// ┌────────────┬──────┬──────────┬───────────────┬────────────────────┐
// │ Type       │ Love │ Marriage │ Creates Match?│ Extra Data         │
// ├────────────┼──────┼──────────┼───────────────┼────────────────────┤
// │ LIKE       │  ✓   │    ✓     │ If mutual     │ —                  │
// │ PASS       │  ✓   │    ✓     │ Never         │ —                  │
// │ SUPER_LIKE │  ✗   │    ✓     │ If other LIKE │ —                  │
// │ SPARK      │  ✓   │    ✗     │ Never         │ sparkSubmissionId  │
// └────────────┴──────┴──────────┴───────────────┴────────────────────┘
//
// Match creation rules:
//   LIKE + LIKE = Match
//   SUPER_LIKE + LIKE = Match (the other party must LIKE back)
//   SPARK never creates a Match
// ─────────────────────────────────────────────

enum InteractionType {
  LIKE
  PASS
  SUPER_LIKE // Marriage users only
  SPARK // Love users only — never creates a Match
}

model ProfileInteraction {
  id              String          @id @default(uuid()) @db.Uuid
  fromProfileId   String          @db.Uuid
  fromProfile     Profile         @relation("InteractionSender", fields: [fromProfileId], references: [id], onDelete: Cascade)
  toProfileId     String          @db.Uuid
  toProfile       Profile         @relation("InteractionReceiver", fields: [toProfileId], references: [id], onDelete: Cascade)
  interactionType InteractionType

  // Populated only when interactionType = SPARK.
  // Links to the full Spark workflow object.
  sparkSubmissionId String?          @unique @db.Uuid
  sparkSubmission   SparkSubmission? @relation(fields: [sparkSubmissionId], references: [id])

  // updatedAt tracks when the state last changed (e.g. PASS → LIKE on second chance)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One current-state row per directional pair. Use upsert to change.
  @@unique([fromProfileId, toProfileId])
  @@index([toProfileId, interactionType])
  @@index([fromProfileId])
  @@index([toProfileId])
  @@index([interactionType])
}

// ─────────────────────────────────────────────
// MATCH
// Created automatically when LIKE + LIKE occurs.
// SUPER_LIKE requires the other party to LIKE back.
// SPARK never creates a Match.
//
// CANONICAL ORDERING (enforced by backend before every insert/query):
//   profileOneId = lexicographically smaller UUID
//   profileTwoId = lexicographically larger UUID
// This prevents duplicate (A,B) and (B,A) records.
// (We use @@index instead of @@unique to permit future rematching).
// ─────────────────────────────────────────────

model Match {
  id           String    @id @default(uuid()) @db.Uuid
  profileOneId String    @db.Uuid // always the lexicographically smaller UUID
  profileOne   Profile   @relation("MatchProfileOne", fields: [profileOneId], references: [id], onDelete: Cascade)
  profileTwoId String    @db.Uuid // always the lexicographically larger UUID
  profileTwo   Profile   @relation("MatchProfileTwo", fields: [profileTwoId], references: [id], onDelete: Cascade)
  chat         Chat?
  unmatchedAt  DateTime? // soft-delete; preserves chat history
  createdAt    DateTime  @default(now())

  // Using @@index instead of @@unique allows A and B to rematch in the future
  // resulting in a new Match row and a fresh Chat history.
  @@index([profileOneId, profileTwoId])
  @@index([profileOneId])
  @@index([profileTwoId])
}

// ─────────────────────────────────────────────
// CHAT & MESSAGES
// ─────────────────────────────────────────────

enum MessageType {
  TEXT
  IMAGE
  VOICE
  VIDEO
  SYSTEM
}

model Chat {
  id            String    @id @default(uuid()) @db.Uuid
  matchId       String    @unique @db.Uuid
  match         Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  messages      Message[]
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Message {
  id              String      @id @default(uuid()) @db.Uuid
  clientMessageId String?     @unique
  chatId          String      @db.Uuid
  chat            Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderProfileId String?     @db.Uuid // Optional for SYSTEM messages
  senderProfile   Profile?    @relation(fields: [senderProfileId], references: [id])
  type            MessageType @default(TEXT)
  content         String?     @db.Text
  mediaUrl        String?
  isRead          Boolean     @default(false)
  readAt          DateTime?
  isDelivered     Boolean     @default(false)
  deliveredAt     DateTime?
  isEdited        Boolean     @default(false)
  editedAt        DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  @@index([chatId])
  @@index([senderProfileId])
  @@index([chatId, createdAt])
}

// ─────────────────────────────────────────────
// TRUST & SAFETY
// ─────────────────────────────────────────────

model Block {
  id               String   @id @default(uuid()) @db.Uuid
  blockerProfileId String   @db.Uuid
  blockerProfile   Profile  @relation("ProfileBlocks", fields: [blockerProfileId], references: [id], onDelete: Cascade)
  blockedProfileId String   @db.Uuid
  blockedProfile   Profile  @relation("BlockedByProfiles", fields: [blockedProfileId], references: [id], onDelete: Cascade)
  reason           String?
  createdAt        DateTime @default(now())

  @@unique([blockerProfileId, blockedProfileId])
  @@index([blockerProfileId])
  @@index([blockedProfileId])
}

enum ReportReason {
  FAKE_PROFILE
  HARASSMENT
  INAPPROPRIATE_CONTENT
  SPAM
  SCAM
  UNDERAGE
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model Report {
  id                String           @id @default(uuid()) @db.Uuid
  reporterProfileId String           @db.Uuid
  reporterProfile   Profile          @relation("ReportsCreated", fields: [reporterProfileId], references: [id], onDelete: Cascade)
  reportedProfileId String           @db.Uuid
  reportedProfile   Profile          @relation("ReportsReceived", fields: [reportedProfileId], references: [id], onDelete: Cascade)
  reason            ReportReason
  description       String?          @db.Text
  status            ReportStatus     @default(PENDING)
  evidence          ReportEvidence[]
  resolvedAt        DateTime?
  assignedToId      String?          @db.Uuid
  assignedTo        User?            @relation("ReportAssignee", fields: [assignedToId], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([reportedProfileId])
  @@index([status])
}

model ReportEvidence {
  id        String   @id @default(uuid()) @db.Uuid
  reportId  String   @db.Uuid
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  mediaUrl  String
  mediaType String? // "image" | "video" | "screenshot"
  createdAt DateTime @default(now())

  @@index([reportId])
}

enum ModerationActionType {
  WARNING
  TEMP_SUSPENSION
  PERMANENT_BAN
  CONTENT_REMOVAL
  PROFILE_RESET
}

model ModerationAction {
  id         String               @id @default(uuid()) @db.Uuid
  userId     String               @db.Uuid
  user       User                 @relation("UserModerationActions", fields: [userId], references: [id], onDelete: Cascade)
  adminId    String               @db.Uuid
  admin      User                 @relation("AdminModerationActions", fields: [adminId], references: [id])
  actionType ModerationActionType
  reason     String               @db.Text
  expiresAt  DateTime? // For temp suspensions
  createdAt  DateTime             @default(now())

  @@index([userId])
  @@index([adminId])
}

// ─────────────────────────────────────────────
// AI REPORT CONFIGURATION
// ─────────────────────────────────────────────

enum ReportConfigType {
  SYNC_REPORT
  INSIGHT_REPORT
}

model AIReportConfig {
  id         String           @id @default(uuid()) @db.Uuid
  type       ReportConfigType @unique
  parameters Json // The 5 Sync parameters or 8 Insight parameters defining the report structure
  isActive   Boolean          @default(true)
  version    Int              @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// DIGITAL WALLET & ECONOMY
// ─────────────────────────────────────────────

model CoinPricingConfig {
  id          String   @id @default(uuid()) @db.Uuid
  actionName  String   @unique // e.g., BUY_EXTRA_SPARKS, UNLOCK_PHOTO
  coinCost    Int
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Wallet {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @unique @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance Int    @default(0) // Total coins available

  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TransactionType {
  PURCHASE // User bought coins with real money
  SPEND // User spent coins (e.g., unlocking a photo, sending extra spark)
  EARN // User earned coins (e.g., daily login reward)
  REFUND // System refunded coins
}

// In-app coin ledger
model WalletTransaction {
  id       String @id @default(uuid()) @db.Uuid
  walletId String @db.Uuid
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  amount      Int // Can be positive (earn/purchase) or negative (spend)
  type        TransactionType
  description String // E.g., "Sent extra Spark to Alice", "Bought 100 coins"

  createdAt DateTime @default(now())
}

enum FiatTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// Real-world money tracking
model FiatTransaction {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount           Decimal               @db.Decimal(10, 2)
  currency         String                @default("USD")
  coinsCredited    Int
  status           FiatTransactionStatus @default(PENDING)
  paymentGatewayId String? // Stripe/Razorpay transaction ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// SOCIAL TAB
// ─────────────────────────────────────────────

model SocialTopic {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @unique
  isActive     Boolean      @default(true)
  displayOrder Int?
  posts        SocialPost[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model SocialPost {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId     String          @db.Uuid
  topic       SocialTopic     @relation(fields: [topicId], references: [id], onDelete: Restrict)
  isAnonymous Boolean         @default(false)
  title       String
  body        String
  voteCount   Int             @default(0)
  comments    SocialComment[]
  votes       SocialVote[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model SocialComment {
  id          String          @id @default(uuid()) @db.Uuid
  postId      String          @db.Uuid
  post        SocialPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId      String          @db.Uuid
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId    String?         @db.Uuid
  parent      SocialComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     SocialComment[] @relation("CommentReplies")
  isAnonymous Boolean         @default(false)
  body        String
  voteCount   Int             @default(0)
  votes       SocialVote[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model SocialVote {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String?        @db.Uuid
  post      SocialPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?        @db.Uuid
  comment   SocialComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  value     Int // 1 for upvote, -1 for downvote

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, postId])
  @@unique([userId, commentId])
}
